{
  "name": "@miraiforge/pi-jbcontext",
  "version": "0.2.0",
  "description": "Pi extension that mirrors the JetBrains Context (jbcontext) agent hooks: session-boundary indexing and bootstrap-first semantic-search reminders",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test --experimental-test-coverage --test-coverage-include=extensions/** --test-coverage-lines=90 --test-coverage-branches=90 tests/*.test.mjs"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "jbcontext",
    "jetbrains-context",
    "semantic-search",
    "code-search"
  ],
  "pi": {
    "extensions": ["./extensions"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MiraiForge/pi-jbcontext.git"
  },
  "homepage": "https://github.com/MiraiForge/pi-jbcontext",
  "bugs": "https://github.com/MiraiForge/pi-jbcontext/issues",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.8.0"
  }
}
